<!doctype html>
<html lang="sw"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MBATA AGENT</title>
<style>
:root{--bg:#0e1b1a;--surface:#152624;--surface2:#1d332f;--line:#2a423c;--text:#eaf2ef;--muted:#8fa89f;--accent:#d9a441;--ok:#5fb088;--bad:#e2665b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px Inter,Arial,sans-serif}button,input,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:24px;width:min(420px,100%)}h1,h2,h3{margin:0 0 10px}.muted{color:var(--muted)}label{display:block;color:var(--muted);margin:12px 0 5px}input,select{width:100%;padding:11px;border-radius:7px;border:1px solid var(--line);background:var(--surface2);color:var(--text)}button{padding:10px 13px;border-radius:7px;border:1px solid var(--line);background:var(--surface2);color:var(--text)}.primary{background:var(--accent);color:#171108;border:0;font-weight:700}.danger{color:#fff;background:transparent;border-color:var(--bad)}
.row{display:flex;gap:8px;flex-wrap:wrap}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px}.value{font-size:22px;font-weight:700}.layout{min-height:100vh;display:flex;flex-direction:column}.top{height:58px;background:var(--surface);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 18px}.body{display:flex;flex:1}.side{width:210px;border-right:1px solid var(--line);padding:10px}.side button{display:block;width:100%;text-align:left;margin:3px 0;background:transparent;border-color:transparent}.side button.active{background:var(--surface);border-color:var(--line)}main{flex:1;padding:24px;overflow:auto}.form{max-width:520px;margin:15px 0}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:8px;border-bottom:1px solid var(--line);text-align:left}.msg{padding:9px;margin:8px 0;border-radius:7px}.ok{background:#163428;color:#a8e1c3}.err{background:#3a1e1b;color:#ffaaa1}.link{background:none;border:0;color:var(--accent);padding:0}.tabs{margin:15px 0}.tabs button{margin-right:6px}.small{font-size:12px}.badge{padding:3px 7px;border-radius:20px;background:var(--surface2)}@media(max-width:760px){.side{position:fixed;z-index:3;left:-230px;top:58px;bottom:0;transition:.2s}.side.open{left:0}main{padding:16px}.menu{display:block!important}}
.menu{display:none;background:none;border:0;font-size:22px}
</style></head><body>
<div id="auth" class="auth"><div class="box">
<h1>◆ MBATA AGENT</h1><p class="muted">Finance • Business • Boss Connect • Education</p>
<div id="authmsg"></div>
<section id="login">
<h2>Ingia</h2><label>Email</label><input id="le"><label>Password</label><input id="lp" type="password">
<button class="primary" style="width:100%;margin-top:14px" onclick="login()">Ingia</button>
<div class="row" style="margin-top:14px"><button class="link" onclick="showAuth('register')">Fungua akaunti</button><button class="link" onclick="showAuth('forgot')">Umesahau password?</button></div>
</section>
<section id="register" class="hidden">
<h2>Fungua akaunti</h2><label>Jina kamili</label><input id="rn"><label>Email</label><input id="re"><label>Password</label><input id="rp" type="password"><label>Rudia password</label><input id="rc" type="password">
<button class="primary" style="width:100%;margin-top:14px" onclick="register()">Fungua</button><button class="link" onclick="showAuth('login')" style="margin-top:14px">Rudi kuingia</button>
</section>
<section id="otp" class="hidden"><h2>Thibitisha email</h2><p class="muted">Weka OTP iliyotumwa kwenye email.</p><label>Email</label><input id="oe"><label>OTP</label><input id="oc" maxlength="6"><button class="primary" style="width:100%;margin-top:14px" onclick="verifyOtp()">Thibitisha</button></section>
<section id="forgot" class="hidden"><h2>Rejesha password</h2><label>Email</label><input id="fe"><button class="primary" style="width:100%;margin-top:14px" onclick="forgot()">Tuma OTP</button><button class="link" onclick="showAuth('login')" style="margin-top:14px">Rudi</button></section>
<section id="reset" class="hidden"><h2>Password mpya</h2><label>Email</label><input id="rse"><label>OTP</label><input id="rso"><label>Password mpya</label><input id="rsp" type="password"><button class="primary" style="width:100%;margin-top:14px" onclick="resetPw()">Badilisha</button></section>
</div></div>

<div id="app" class="layout hidden">
<header class="top"><div><button class="menu" onclick="document.querySelector('.side').classList.toggle('open')">☰</button><b>◆ MBATA AGENT</b></div><div><span id="who" class="muted"></span> <button onclick="logout()">Toka</button></div></header>
<div class="body"><nav class="side" id="side"></nav><main id="main"></main></div></div>

<script>
const $=id=>document.getElementById(id), money=n=>'TSh '+Number(n||0).toLocaleString();
async function api(url,opt={}){let r=await fetch(url,{credentials:'include',headers:{'Content-Type':'application/json',...(opt.headers||{})},...opt});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||'Request failed');return d}
function msg(t,ok=false){$('authmsg').innerHTML=`<div class="msg ${ok?'ok':'err'}">${t}</div>`}
function showAuth(v){['login','register','otp','forgot','reset'].forEach(x=>$(x).classList.toggle('hidden',x!==v));$('authmsg').innerHTML=''}
async function register(){if($('rp').value!==$('rc').value)return msg('Password hazifanani.');try{await api('/api/auth/register',{method:'POST',body:JSON.stringify({fullName:$('rn').value,email:$('re').value,password:$('rp').value})});$('oe').value=$('re').value;showAuth('otp');msg('OTP imetumwa. Fungua email yako.',true)}catch(e){msg(e.message)}}
async function verifyOtp(){try{await api('/api/auth/verify-otp',{method:'POST',body:JSON.stringify({email:$('oe').value,code:$('oc').value})});await boot()}catch(e){msg(e.message)}}
async function login(){try{await api('/api/auth/login',{method:'POST',body:JSON.stringify({email:$('le').value,password:$('lp').value})});await boot()}catch(e){msg(e.message)}}
async function forgot(){try{await api('/api/auth/forgot',{method:'POST',body:JSON.stringify({email:$('fe').value})});$('rse').value=$('fe').value;showAuth('reset');msg('Kama akaunti ipo, OTP imetumwa.',true)}catch(e){msg(e.message)}}
async function resetPw(){try{await api('/api/auth/reset',{method:'POST',body:JSON.stringify({email:$('rse').value,code:$('rso').value,newPassword:$('rsp').value})});showAuth('login');msg('Password imebadilishwa.',true)}catch(e){msg(e.message)}}
async function logout(){await api('/api/auth/logout',{method:'POST'});location.reload()}
let me=null,profiles=[],module='dashboard',sub={business:'products',boss:'boss',education:'parent'};
async function boot(){try{let d=await api('/api/me');me=d.user;profiles=(await api('/api/profiles')).profiles;$('auth').classList.add('hidden');$('app').classList.remove('hidden');$('who').textContent=me.full_name;renderNav();openModule('dashboard')}catch{}}
function renderNav(){let items=[['dashboard','🏠 Dashboard'],['finance','💰 Finance'],['business','🏪 Business'],['boss','🔗 Boss Connect'],['education','🎓 Education'],['notifications','🔔 Notifications']];$('side').innerHTML=items.map(x=>`<button class="${module===x[0]?'active':''}" onclick="openModule('${x[0]}')">${x[1]}</button>`).join('')}
function openModule(m){module=m;renderNav();document.querySelector('.side').classList.remove('open');({dashboard:dashboard,finance:finance,business:business,boss:boss,education:education,notifications:notifications})[m]()}
function ensureProfile(p){if(profiles.includes(p))return true;$('main').innerHTML=`<div class="box"><h2>Profile ya ${p}</h2><p class="muted">Unda profile kuanza kutumia module hii.</p><button class="primary" onclick="createProfile('${p}')">Unda profile</button></div>`;return false}
async function createProfile(type){await api('/api/profiles',{method:'POST',body:JSON.stringify({type})});profiles.push(type);openModule(module)}
function dashboard(){$('main').innerHTML=`<h2>Dashboard</h2><p class="muted">Karibu ${me.full_name}. Chagua module upande wa kushoto.</p><div class="grid"><div class="card"><div class="muted">Modules</div><div class="value">${profiles.length}</div></div><div class="card"><div class="muted">Akaunti</div><div>${me.email}</div></div></div>`}
async function finance(){if(!ensureProfile('finance'))return;let d=await api('/api/finance');$('main').innerHTML=`<h2>Finance</h2><div class="grid"><div class="card"><div class="muted">Balance</div><div class="value">${money(d.balance)}</div></div><div class="card"><div class="muted">Kipato</div><div class="value">${money(d.income)}</div></div><div class="card"><div class="muted">Matumizi</div><div class="value">${money(d.expense)}</div></div></div>
<div class="card form"><h3>Ongeza transaction</h3><label>Aina</label><select id="ft"><option value="income">Kipato</option><option value="expense">Matumizi</option></select><label>Kiasi</label><input id="fa" type="number"><label>Kategoria</label><input id="fc"><label>Maelezo</label><input id="fn"><button class="primary" onclick="addTx()">Hifadhi</button></div>
<div class="card form"><h3>Ongeza goal</h3><label>Jina</label><input id="gt"><label>Lengo</label><input id="ga" type="number"><button class="primary" onclick="addGoal()">Ongeza</button></div>
<table class="table"><tr><th>Tarehe</th><th>Aina</th><th>Kategoria</th><th>Kiasi</th></tr>${d.transactions.map(x=>`<tr><td>${new Date(x.created_at).toLocaleDateString()}</td><td>${x.type}</td><td>${x.category}</td><td>${money(x.amount)}</td></tr>`).join('')}</table>`}
async function addTx(){await api('/api/finance/transactions',{method:'POST',body:JSON.stringify({type:$('ft').value,amount:$('fa').value,category:$('fc').value,note:$('fn').value})});finance()}
async function addGoal(){await api('/api/finance/goals',{method:'POST',body:JSON.stringify({title:$('gt').value,target:$('ga').value})});finance()}
async function business(){if(!ensureProfile('business'))return;let d=await api('/api/business');$('main').innerHTML=`<h2>Business</h2><div class="grid"><div class="card"><div class="muted">Revenue</div><div class="value">${money(d.revenue)}</div></div><div class="card"><div class="muted">Net Profit</div><div class="value">${money(d.netProfit)}</div></div><div class="card"><div class="muted">Products</div><div class="value">${d.products.length}</div></div></div><div class="tabs"><button onclick="sub.business='products';business()">Bidhaa</button><button onclick="sub.business='sales';business()">Mauzo</button><button onclick="sub.business='customers';business()">Wateja</button><button onclick="sub.business='expenses';business()">Gharama</button></div><div id="bc"></div>`;let c=$('bc');
if(sub.business==='products')c.innerHTML=`<div class="card form"><h3>Ongeza bidhaa</h3><label>Jina</label><input id="pn"><label>Buy price</label><input id="pb" type="number"><label>Sell price</label><input id="ps" type="number"><label>Stock</label><input id="px" type="number"><label>Min stock</label><input id="pm" type="number"><button class="primary" onclick="addProduct()">Hifadhi</button></div><table class="table"><tr><th>Bidhaa</th><th>Sell</th><th>Stock</th></tr>${d.products.map(p=>`<tr><td>${p.name}</td><td>${money(p.sell_price)}</td><td>${p.stock}</td></tr>`).join('')}</table>`;
if(sub.business==='sales')c.innerHTML=`<div class="card form"><h3>Rekodi mauzo</h3><label>Bidhaa</label><select id="sp">${d.products.map(p=>`<option value="${p.id}">${p.name} (${p.stock})</option>`).join('')}</select><label>Idadi</label><input id="sq" type="number" value="1"><button class="primary" onclick="addSale()">Rekodi</button></div><table class="table"><tr><th>Tarehe</th><th>Total</th></tr>${d.sales.map(s=>`<tr><td>${new Date(s.created_at).toLocaleDateString()}</td><td>${money(s.total)}</td></tr>`).join('')}</table>`;
if(sub.business==='customers')c.innerHTML=`<div class="card form"><h3>Mteja</h3><label>Jina</label><input id="cn"><label>Simu</label><input id="cp"><button class="primary" onclick="addCustomer()">Hifadhi</button></div><table class="table"><tr><th>Jina</th><th>Simu</th></tr>${d.customers.map(x=>`<tr><td>${x.name}</td><td>${x.phone||'-'}</td></tr>`).join('')}</table>`;
if(sub.business==='expenses')c.innerHTML=`<div class="card form"><h3>Gharama</h3><label>Kategoria</label><input id="ec"><label>Kiasi</label><input id="ea" type="number"><label>Maelezo</label><input id="en"><button class="primary" onclick="addExpense()">Hifadhi</button></div><table class="table"><tr><th>Kategoria</th><th>Kiasi</th></tr>${d.expenses.map(x=>`<tr><td>${x.category}</td><td>${money(x.amount)}</td></tr>`).join('')}</table>`}
async function addProduct(){await api('/api/business/products',{method:'POST',body:JSON.stringify({name:$('pn').value,buyPrice:$('pb').value,sellPrice:$('ps').value,stock:$('px').value,minStock:$('pm').value})});business()}
async function addSale(){await api('/api/business/sales',{method:'POST',body:JSON.stringify({productId:$('sp').value,qty:$('sq').value})});business()}
async function addCustomer(){await api('/api/business/customers',{method:'POST',body:JSON.stringify({name:$('cn').value,phone:$('cp').value})});business()}
async function addExpense(){await api('/api/business/expenses',{method:'POST',body:JSON.stringify({category:$('ec').value,amount:$('ea').value,note:$('en').value})});business()}
async function boss(){let d=await api('/api/boss-connect');$('main').innerHTML=`<h2>Boss Connect</h2><div class="tabs"><button onclick="sub.boss='boss';boss()">👑 Boss</button><button onclick="sub.boss='driver';boss()">🏍️ Driver</button><button onclick="sub.boss='tenant';boss()">🏠 Tenant</button></div><div id="bct"></div>`;let c=$('bct');
if(sub.boss==='boss'){if(!ensureProfile('boss'))return;c.innerHTML=`<div class="card form"><h3>Ongeza asset</h3><label>Aina</label><select id="at"><option value="motorcycle">Pikipiki</option><option value="property">Nyumba/Chumba</option></select><label>Kiasi</label><input id="aa" type="number"><label>Frequency</label><select id="af"><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select><button class="primary" onclick="addAsset()">Tengeneza</button></div>${d.assets.map(a=>`<div class="card"><b>${a.asset_type}</b> — ${money(a.required_amount)} / ${a.frequency}<div class="badge">${a.code}</div></div>`).join('')}`}
else {let p=sub.boss==='driver'?'driver':'tenant';if(!ensureProfile(p))return;c.innerHTML=`<div class="card form"><h3>Jiunge na Boss</h3><input id="jc" placeholder="MB-BOSS-XXXX"><button class="primary" onclick="joinBoss('${p}')">Tuma ombi</button></div>${d.connections.map(x=>`<div class="card">${x.asset_type} — <span class="badge">${x.status}</span>${x.status==='active'?`<div class="row" style="margin-top:8px"><input id="pa-${x.id}" type="number" placeholder="Kiasi"><input id="pm-${x.id}" placeholder="Mpesa/Cash"><button onclick="pay('${x.id}')">Lipa</button></div>`:''}</div>`).join('')}`}}
async function addAsset(){await api('/api/boss-connect/assets',{method:'POST',body:JSON.stringify({assetType:$('at').value,requiredAmount:$('aa').value,frequency:$('af').value})});boss()}
async function joinBoss(roleType){await api('/api/boss-connect/join',{method:'POST',body:JSON.stringify({code:$('jc').value,roleType})});boss()}
async function pay(id){await api('/api/boss-connect/payments',{method:'POST',body:JSON.stringify({connectionId:id,amount:$('pa-'+id).value,method:$('pm-'+id).value})});boss()}
async function education(){let d=await api('/api/education');$('main').innerHTML=`<h2>Education</h2><div class="tabs"><button onclick="sub.education='parent';education()">Mzazi</button><button onclick="sub.education='student';education()">Mwanafunzi</button></div><div id="ed"></div>`;let c=$('ed');
if(sub.education==='parent'){if(!ensureProfile('parent'))return;c.innerHTML=`<div class="card form"><h3>Unganisha mwanafunzi</h3><input id="se" placeholder="student@email.com"><button class="primary" onclick="linkStudent()">Unganisha</button></div>${d.links.map(x=>`<div class="card"><b>${x.full_name}</b><div class="muted">${x.school_name||''} ${x.class_name||''}</div></div>`).join('')}`}
else{if(!ensureProfile('student'))return;c.innerHTML=`<div class="card form"><h3>Student details</h3><input id="sn" placeholder="Student number"><input id="ss" placeholder="School"><input id="sc" placeholder="Class"><button class="primary" onclick="saveStudent()">Hifadhi</button></div><div class="card form"><h3>Result</h3><input id="subj" placeholder="Subject"><input id="score" type="number" placeholder="Score"><input id="max" type="number" value="100"><input id="term" placeholder="Term"><button onclick="addResult()">Hifadhi result</button></div><div class="card"><button class="primary" onclick="att(true)">Nilikuwepo</button> <button onclick="att(false)">Sikuwepo</button></div>`}}
async function linkStudent(){await api('/api/education/link-parent',{method:'POST',body:JSON.stringify({studentEmail:$('se').value})});education()}
async function saveStudent(){await api('/api/education/student',{method:'POST',body:JSON.stringify({studentNumber:$('sn').value,schoolName:$('ss').value,className:$('sc').value})});education()}
async function addResult(){await api('/api/education/results',{method:'POST',body:JSON.stringify({subject:$('subj').value,score:$('score').value,maxScore:$('max').value,term:$('term').value})});education()}
async function att(present){await api('/api/education/attendance',{method:'POST',body:JSON.stringify({present})});education()}
async function notifications(){let d=await api('/api/notifications');$('main').innerHTML=`<h2>Notifications</h2>${d.notifications.map(n=>`<div class="card" style="margin:8px 0"><b>${n.title}</b><p class="muted">${n.body}</p><small>${new Date(n.created_at).toLocaleString()}</small></div>`).join('')||'<p class="muted">Hakuna notifications.</p>'}`}
boot();
</script></body></html>
